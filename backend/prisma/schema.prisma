// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id              String    @id @default(cuid())
  name            String    @unique  // ENTERPRISE, LITE
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  billingCycle    String    @default("MONTHLY") // MONTHLY, YEARLY, ONETIME
  maxBranches     Int       @default(1)
  maxUsersPerBranch Int?    // null = unlimited
  features        String[]  // JSON array de features
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id              String    @id @default(cuid())
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id])

  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, BLOCKED, CANCELLED
  startDate       DateTime  @default(now())
  endDate         DateTime
  renewalDate     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company?

  @@index([planId])
}

model Company {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique @default(cuid())
  email           String    @unique
  phone           String?
  industry        String?   // Restaurante, Cafetería, etc.
  logoUrl         String?   @db.Text // data URL (base64) del logo personalizado

  // Plan y Suscripción (one-to-one)
  subscriptionId  String?   @unique
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  // Información de Pago
  contactPerson   String?
  paymentEmail    String?

  // Pagos en línea: credenciales MercadoPago de la EMPRESA (el dinero cae en su cuenta)
  mpAccessToken   String?
  mpPublicKey     String?

  // Subsidio de comida: la empresa cubre N comidas/día por comensal (se marcan, no se cobran)
  subsidyEnabled     Boolean @default(false)
  subsidyMealsPerDay Int     @default(1)
  // Costo fijo "legado" (antes de tener niveles) — se conserva para no romper compañías
  // ya configuradas; el costo real ahora vive en SubsidyTier.
  subsidyMealCost    Decimal @default(75) @db.Decimal(10, 2)
  // Última vez que RH pagó/liquidó el saldo subsidiado acumulado. El "saldo subsidiado"
  // que ve cada comensal es la suma de sus comidas subsidiadas DESDE esta fecha (sin IVA:
  // el comensal ve el costo base, el IVA solo aparece en el reporte que paga RH).
  subsidySettledAt   DateTime?
  subsidyIvaRate     Decimal   @default(16) @db.Decimal(5, 2)
  subsidyTiers       SubsidyTier[]

  // Menú rotativo de 8 semanas: un ciclo de platillos por día que se repite cada 8
  // semanas, para que el comedor no repita menú seguido. menuRotationMode define si
  // la semana activa se calcula sola desde menuRotationStartDate (AUTO) o la elige
  // el admin a mano (MANUAL, usa menuRotationManualWeek).
  menuRotationEnabled    Boolean   @default(false)
  menuRotationStartDate  DateTime?
  menuRotationMode       String    @default("AUTO") // AUTO | MANUAL
  menuRotationManualWeek Int?
  menuRotationDays       MenuRotationDay[]

  // Secciones habilitadas por el master admin (inventario, RH, pagos...). Claves ausentes = habilitado.
  enabledFeatures Json?

  // Facturación (comentado temporalmente - agregar después con migration)
  // licenseFee      Decimal   @default(0) @db.Decimal(10, 2)
  // hostingFee      Decimal   @default(0) @db.Decimal(10, 2)
  // licenseRenewalDate DateTime?
  // nextBillingDate DateTime?
  // additionalBranches Int @default(0)

  // Status
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  blockReason     String?

  // Master Admin de esta empresa
  masterAdminEmail String?

  // Auditoría
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  branches        Branch[]
  payments        CompanyPayment[]
  // invoices        CompanyInvoice[]

  @@index([subscriptionId])
}

model CompanyPayment {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  amount          Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDING") // PENDING, PAID, FAILED
  description     String?
  invoiceNumber   String?

  paymentDate     DateTime?
  dueDate         DateTime

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
}

