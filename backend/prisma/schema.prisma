model Branch {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  slug            String    @default(cuid())
  location        String?
  isActive        Boolean   @default(true)

  subsidyMealsPerDay Int?   // Override de comidas subsidiadas/día para esta sucursal (null = usar el de la empresa)
  useMenuRotation Boolean   @default(false) // si usa el menú rotativo de 8 semanas de la empresa
  // Cada sucursal decide: AUTO (sigue el ciclo de 8 semanas de la empresa) o MANUAL (esta
  // sucursal puso su propio platillo de hoy, sin importar lo que toque en el ciclo).
  // null = se comporta como AUTO.
  menuRotationMode String? // AUTO | MANUAL | null
  manualMenuName    String?
  manualMenuPrice   Decimal? @db.Decimal(10, 2)

  // Licencia y Pago
  licenseStatus   String    @default("ACTIVE") // ACTIVE, EXPIRED, BLOCKED, TRIAL
  licenseExpiry   DateTime?
  isBlocked       Boolean   @default(false)
  blockReason     String?

  // Información de Pago (hereda de Company)
  monthlyFee      Decimal   @default(0) @db.Decimal(10, 2)
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?

  // Auditoría
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cashiers        Cashier[]
  users           User[]
  payments        BranchPayment[]
  products        Product[]
  cashierSessions CashierSession[]
  subsidyTiers    SubsidyTier[]

  @@index([companyId])
}

model BranchPayment {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING, PAID, FAILED
  description String?
  paymentDate DateTime?
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId])
}

model Cashier {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([branchId])
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  employeeNumber String
  phone          String
  role           Role          @default(USER)
  balance        Decimal       @default(0) @db.Decimal(10, 2)
  qrCode         String        @unique
  isActive       Boolean       @default(true)
  isBlocked      Boolean       @default(false)
  blockReason    String?
  minBalance     Decimal       @default(0) @db.Decimal(10, 2)
  dailyLimit     Decimal       @default(0) @db.Decimal(10, 2)
  photoUrl       String?
  position       String?       // Puesto del equipo de operación: Chef, Cocinero, Mesero, etc.
  isStaff        Boolean       @default(false) // true = equipo de operación (no comensal)
  subsidyMealsPerDay Int?      // Override de comidas subsidiadas/día (null = usar el de la empresa)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transactions   Transaction[]
  recharges      Recharge[]

  @@index([branchId])
}

model Transaction {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TransactionType
  amount         Decimal         @db.Decimal(10, 2)
  balanceBefore  Decimal?        @db.Decimal(10, 2)
  balanceAfter   Decimal?        @db.Decimal(10, 2)
  description    String
  status         String          @default("COMPLETED")
  cashierId      String?
  paymentMethod  PaymentMethod?
  reference      String?
  isSubsidized   Boolean         @default(false) // comida cubierta por la empresa (no descuenta saldo)
  isCashSale     Boolean         @default(false) // pagó en efectivo en el momento, no descuenta saldo de la app
  cashReceived   Decimal?        @db.Decimal(10, 2) // solo si isCashSale: con cuánto pagó
  cashChange     Decimal?        @db.Decimal(10, 2) // solo si isCashSale: cuánto le dio de cambio el cajero
  createdAt      DateTime        @default(now())

  items          TransactionItem[]

  @@index([userId])
  @@index([createdAt])
}

model Recharge {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal        @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  status         RechargeStatus @default(PENDING)
  reference      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

enum Role {
  USER
  CASHIER
  ADMIN
}

enum TransactionType {
  PURCHASE
  RECHARGE
  REFUND
}

enum PaymentMethod {
  CASH
  STRIPE
  MERCADOPAGO
}

enum RechargeStatus {
  PENDING
  COMPLETED
  FAILED
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  category    String   @default("General")
  image       String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  productType String   @default("PLATILLO") // PLATILLO | PRODUCTO
  stock       Int      @default(-1)
  minStock    Int      @default(0)
  isTracked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  restockRequests  RestockRequest[]

  @@index([branchId])
}

// El cajero solicita reabasto de un producto; el admin lo ve y lo resuelve (reabastece o descarta).
model RestockRequest {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId    String
  quantity    Int?
  note        String?
  status      String    @default("PENDING") // PENDING | FULFILLED | DISMISSED
  requestedBy String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([branchId])
  @@index([productId])
  @@index([status])
}

// Niveles de subsidio de una empresa (ej. Estándar $75, Especial $120). El cajero,
// al marcar un cobro como subsidiado, elige uno de estos — no cualquier platillo del menú.
model SubsidyTier {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?  // null = aplica a todas las sucursales de la empresa
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  cost      Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([branchId])
}

// Un platillo del ciclo de 8 semanas: week 1-8, dayOfWeek 1-7 (1=lunes...7=domingo).
model MenuRotationDay {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  week      Int
  dayOfWeek Int
  name      String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, week, dayOfWeek])
  @@index([companyId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  quantity  Int
  prevStock Int
  newStock  Int
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)

  @@index([transactionId])
  @@index([productId])
}

model CashierSession {
  id           String    @id @default(cuid())
  cashierId    String
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  initialFloat Decimal   @default(0) @db.Decimal(10, 2)
  finalBalance Decimal?  @db.Decimal(10, 2)
  totalCharges Decimal   @default(0) @db.Decimal(10, 2)
  status       String    @default("OPEN") // OPEN, CLOSED, RECONCILED
  notes        String?
  shiftNumber  Int       @default(1) // turno del día para esa sucursal: 1, 2 o 3
  dishesCount  Int?      // platillos (PLATILLO) servidos durante el turno, calculado al cerrar

  @@index([branchId])
}

model UserAlert {
  id        String   @id @default(cuid())
  userId    String
  type      String   // LOW_BALANCE, BLOCKED, PURCHASE, RECHARGE, SUBSIDIZED, etc
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Suscripción a notificaciones push del navegador (Web Push). Un usuario puede tener
// varias (un dispositivo/navegador distinto = una suscripción distinta).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Registro de asistencia (entrada/salida de operación por QR)
model Attendance {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  type      String   // IN | OUT
  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([userId])
}
